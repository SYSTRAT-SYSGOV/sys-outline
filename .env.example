# Copie este arquivo para `.env` e preencha os valores antes de subir o Docker Compose:
#   cp .env.example .env
# O arquivo `.env` da raiz é ignorado pelo Git.

# Banco de dados MySQL
MYSQL_DATABASE=escriba
MYSQL_USER=escriba
MYSQL_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-de-root

# Chave de criptografia do Laravel (gere com: php artisan key:generate --show)
APP_KEY=base64:gere-uma-chave-com-artisan-key-generate
